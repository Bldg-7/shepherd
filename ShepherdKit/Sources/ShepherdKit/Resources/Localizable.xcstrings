      }
    },
    "The command exited with status %lld." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "コマンドがステータス %lld で終了しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "명령이 상태 %lld(으)로 종료되었습니다." } }
      }
    },
    "The connection to the machine closed unexpectedly." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンとの接続が予期せず切断されました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신과의 연결이 예기치 않게 끊어졌습니다." } }
      }
    },
    "The host command exceeded its deadline; the operation did not complete successfully." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストのコマンドが制限時間を超えました。操作は正常に完了していません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 명령이 제한 시간을 초과했습니다. 작업이 정상 완료되지 않았습니다." } }
      }
    },
    "The key data is malformed" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "鍵のデータが不正です" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "키 데이터의 형식이 잘못되었습니다" } }
      }
    },
    "The machine didn't answer in time." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンから時間内に応答がありませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신이 제시간에 응답하지 않았습니다." } }
      }
    },
    "The machine doesn't accept key logins." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンは鍵によるログインを受け付けていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 머신은 키 로그인을 허용하지 않습니다." } }
      }
    },
    "The machine doesn't accept password logins. Set the machine up with a key instead." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンはパスワードによるログインを受け付けていません。代わりに鍵を使うように設定してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 머신은 암호 로그인을 허용하지 않습니다. 대신 키를 사용하도록 머신을 설정하십시오." } }
      }
    },
    "The machine doesn't accept this kind of login." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンはこの方式のログインを受け付けていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 머신은 이 방식의 로그인을 허용하지 않습니다." } }
      }
    },
    "The machine settings changed. Reopen the machine and try again." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The machine settings changed. Reopen the machine and try again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンの設定が変更されました。開き直して再試行してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신 설정이 변경되었습니다. 다시 열어 수정해 주세요." } }
      }
    },
    "The machine turned the login down: the password is wrong, or the key isn't in that account's ~/.ssh/authorized_keys." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンがログインを拒否しました。パスワードが間違っているか、鍵がそのアカウントの ~/.ssh/authorized_keys に登録されていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신이 로그인을 거부했습니다. 암호가 틀렸거나, 키가 해당 계정의 ~/.ssh/authorized_keys에 등록되어 있지 않습니다." } }
      }
    },
    "This Mac" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMac" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac" } }
      }
    },
    "This host's SSH key doesn't match the one we pinned on first connect (expected %@, got %@). This usually means the server was reinstalled — but it's also exactly what a man-in-the-middle attack looks like, so this connection was refused rather than silently trusting it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このホストの SSH 鍵が、最初の接続時に固定した鍵と一致しません(期待値: %1$@、実際: %2$@)。通常はサーバの再インストールが原因ですが、中間者攻撃もまったく同じように見えるため、黙って信頼せずに接続を拒否しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 호스트의 SSH 키가 처음 연결할 때 고정한 키와 일치하지 않습니다(예상: %1$@, 실제: %2$@). 보통은 서버를 다시 설치해서 생기는 일이지만, 중간자 공격도 정확히 이렇게 보이므로 그대로 신뢰하지 않고 연결을 거부했습니다." } }
      }
    },
    "This machine cannot be edited or was removed." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This machine cannot be edited or was removed." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンは編集できないか、削除されています。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "수정할 수 없거나 삭제된 머신입니다." } }
      }
    },
    "Timed out" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "タイムアウトしました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시간 초과" } }
      }
    },
    "Too many open files" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "開いているファイルが多すぎます" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "열린 파일이 너무 많음" } }
      }
    },
    "Unknown" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "不明" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "알 수 없음" } }
      }
    },
    "Unsupported key type '%@'" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "対応していない鍵の種類 '%@'" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지원하지 않는 키 유형 '%@'" } }
      }
    },
    "Working" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "作業中" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "작업 중" } }
      }
    },
    "herdr exited with status %lld." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr がステータス %lld で終了しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr가 상태 %lld(으)로 종료되었습니다." } }
      }
