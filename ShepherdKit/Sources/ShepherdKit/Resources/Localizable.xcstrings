      }
    },
    "The command exited with status %lld." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "コマンドがステータス %lld で終了しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "명령이 상태 %lld(으)로 종료되었습니다." } }
      }
    },
    "The connection to the machine closed unexpectedly." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンとの接続が予期せず切断されました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신과의 연결이 예기치 않게 끊어졌습니다." } }
      }
    },
    "The host command exceeded its deadline; the operation did not complete successfully." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストのコマンドが制限時間を超えました。操作は正常に完了していません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 명령이 제한 시간을 초과했습니다. 작업이 정상 완료되지 않았습니다." } }
      }
    },
    "The key data is malformed" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "鍵のデータが不正です" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "키 데이터의 형식이 잘못되었습니다" } }
      }
    },
    "The machine didn't answer in time." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンから時間内に応答がありませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신이 제시간에 응답하지 않았습니다." } }
      }
    },
    "The machine doesn't accept key logins." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンは鍵によるログインを受け付けていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 머신은 키 로그인을 허용하지 않습니다." } }
      }
    },
    "The machine doesn't accept password logins. Set the machine up with a key instead." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンはパスワードによるログインを受け付けていません。代わりに鍵を使うように設定してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 머신은 암호 로그인을 허용하지 않습니다. 대신 키를 사용하도록 머신을 설정하십시오." } }
      }
    },
    "The machine doesn't accept this kind of login." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンはこの方式のログインを受け付けていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 머신은 이 방식의 로그인을 허용하지 않습니다." } }
      }
    },
    "The machine settings changed. Reopen the machine and try again." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The machine settings changed. Reopen the machine and try again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンの設定が変更されました。開き直して再試行してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신 설정이 변경되었습니다. 다시 열어 수정해 주세요." } }
      }
    },
    "The machine turned the login down: the password is wrong, or the key isn't in that account's ~/.ssh/authorized_keys." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンがログインを拒否しました。パスワードが間違っているか、鍵がそのアカウントの ~/.ssh/authorized_keys に登録されていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신이 로그인을 거부했습니다. 암호가 틀렸거나, 키가 해당 계정의 ~/.ssh/authorized_keys에 등록되어 있지 않습니다." } }
      }
    },
    "This Mac" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMac" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac" } }
      }
    },
    "This host's SSH key doesn't match the one we pinned on first connect (expected %@, got %@). This usually means the server was reinstalled — but it's also exactly what a man-in-the-middle attack looks like, so this connection was refused rather than silently trusting it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このホストの SSH 鍵が、最初の接続時に固定した鍵と一致しません(期待値: %1$@、実際: %2$@)。通常はサーバの再インストールが原因ですが、中間者攻撃もまったく同じように見えるため、黙って信頼せずに接続を拒否しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 호스트의 SSH 키가 처음 연결할 때 고정한 키와 일치하지 않습니다(예상: %1$@, 실제: %2$@). 보통은 서버를 다시 설치해서 생기는 일이지만, 중간자 공격도 정확히 이렇게 보이므로 그대로 신뢰하지 않고 연결을 거부했습니다." } }
      }
    },
    "This machine cannot be edited or was removed." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This machine cannot be edited or was removed." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンは編集できないか、削除されています。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "수정할 수 없거나 삭제된 머신입니다." } }
      }
    },
    "Timed out" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "タイムアウトしました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시간 초과" } }
      }
    },
    "Too many open files" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "開いているファイルが多すぎます" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "열린 파일이 너무 많음" } }
      }
    },
    "Unknown" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "不明" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "알 수 없음" } }
      }
    },
    "Unsupported key type '%@'" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "対応していない鍵の種類 '%@'" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지원하지 않는 키 유형 '%@'" } }
      }
    },
    "Working" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "作業中" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "작업 중" } }
      }
    },
    "herdr exited with status %lld." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr がステータス %lld で終了しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr가 상태 %lld(으)로 종료되었습니다." } }
      }
    },
    "herdr's answer didn't name the new tab." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr の応答に新しい tab が含まれていませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr의 응답에 새 tab이 없습니다." } }
      }
    },
    "herdr.sock closed the connection without responding" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr.sock が応答せずに接続を閉じました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr.sock이 응답 없이 연결을 닫았습니다" } }
      }
    },
    "herdr.sock's path is too long for a Unix domain socket" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr.sock のパスが Unix ドメインソケットには長すぎます" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr.sock 경로가 Unix 도메인 소켓에 쓰기에는 너무 깁니다" } }
      }
    },
    "read failed: %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み取りに失敗しました: %@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "읽기 실패: %@" } }
      }
    },
    "write failed: %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "書き込みに失敗しました: %@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "쓰기 실패: %@" } }
      }
    },
    "The host didn't finish within %lld seconds." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストが %lld 秒以内に終わりませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트가 %lld초 안에 끝내지 못했습니다." } }
      }
    },
    "Loading…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込み中…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "불러오는 중…" } }
      }
    },
    "This machine's herdr is older than 0.9.0, the first to save machines. Update herdr to add machines to it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このマシンの herdr は、マシンの保存に初めて対応した 0.9.0 より古いバージョンです。マシンを追加するには herdr をアップデートしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 머신의 herdr는 머신 저장을 처음 지원한 0.9.0보다 오래되었습니다. herdr를 업데이트해야 머신을 추가할 수 있습니다." } }
      }
    },
    "A name can't have control characters in it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "名前に制御文字は使えません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이름에 제어 문자를 넣을 수 없습니다." } }
      }
    },
    "Add %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ を追加" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 추가" } }
      }
    },
    "Adding the host key to %@…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ にホスト鍵を追加中…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@에 호스트 키를 추가하는 중…" } }
      }
    },
    "An SSH target can't have spaces in it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "SSH の接続先に空白は使えません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "SSH 대상에는 공백을 넣을 수 없습니다." } }
      }
    },
    "An SSH target can't start with “-”." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "SSH の接続先は「-」で始められません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "SSH 대상은 ‘-’로 시작할 수 없습니다." } }
      }
    },
    "Another machine is called “%@” already." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」という名前のマシンがすでにあります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘%@’(이)라는 이름의 머신이 이미 있습니다." } }
      }
    },
    "Checking whether herdr saved it anyway…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr が保存したかどうかを確認中…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "그래도 herdr가 저장했는지 확인하는 중…" } }
      }
    },
    "Continue in a terminal, where OpenSSH can ask about it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH が確認できるターミナルで続けてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH가 직접 물어볼 수 있는 터미널에서 계속하십시오." } }
      }
    },
    "Couldn't open a tab on %@: %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ で tab を開けませんでした: %2$@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%1$@에서 tab을 열 수 없습니다: %2$@" } }
      }
    },
    "Fetching the host key didn't finish within %lld seconds." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホスト鍵の取得が %lld 秒以内に終わりませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 키 가져오기가 %lld초 안에 끝나지 않았습니다." } }
      }
    },
    "Leave the password out of the target: herdr signs in with keys only." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続先からパスワードを外してください。herdr は鍵でのみログインします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대상에서 암호를 빼십시오. herdr는 키로만 로그인합니다." } }
      }
    },
    "Nothing was changed. If the machine was set up again, remove its old key with `ssh-keygen -R %@` on %@, then try again." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "何も変更していません。マシンを再セットアップした場合は、%2$@ で `ssh-keygen -R %1$@` を実行して古い鍵を削除してから再試行してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아무것도 바꾸지 않았습니다. 머신을 다시 설치했다면 %2$@에서 `ssh-keygen -R %1$@`로 이전 키를 지운 뒤 다시 시도하십시오." } }
      }
    },
    "OpenSSH couldn't read its configuration for this target." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH がこの接続先の設定を読み取れませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH가 이 대상의 설정을 읽지 못했습니다." } }
      }
    },
    "OpenSSH didn't answer within %lld seconds." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH が %lld 秒以内に応答しませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH가 %lld초 안에 응답하지 않았습니다." } }
      }
    },
    "OpenSSH didn't hand over the target's host key — it may be reached through a machine whose key isn't known yet. Continue in a terminal, where OpenSSH can ask about it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH が接続先のホスト鍵を渡しませんでした。鍵がまだ分からない別のマシンを経由する接続先かもしれません。OpenSSH が確認できるターミナルで続けてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH가 대상의 호스트 키를 넘겨주지 않았습니다. 키를 아직 모르는 다른 머신을 거쳐 연결하는 대상일 수 있습니다. OpenSSH가 직접 물어볼 수 있는 터미널에서 계속하십시오." } }
      }
    },
    "OpenSSH still doesn't know the host key after it was added. Continue in a terminal, where OpenSSH can ask about it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホスト鍵を追加しても OpenSSH はまだその鍵を認識していません。OpenSSH が確認できるターミナルで続けてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 키를 추가했는데도 OpenSSH가 여전히 그 키를 모릅니다. OpenSSH가 직접 물어볼 수 있는 터미널에서 계속하십시오." } }
      }
    },
    "OpenSSH's configuration gives this target a RemoteCommand, which leaves herdr no way to run its own commands there. Use a Host alias without one." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH の設定でこの接続先に RemoteCommand が指定されているため、herdr はそこで自分のコマンドを実行できません。RemoteCommand のない Host エイリアスを使ってください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH 설정이 이 대상에 RemoteCommand를 지정하고 있어 herdr가 그곳에서 자기 명령을 실행할 수 없습니다. RemoteCommand가 없는 Host 별칭을 쓰십시오." } }
      }
    },
    "OpenSSH's configuration keeps no known host keys for this target (UserKnownHostsFile /dev/null), so herdr's strict host key checking could never pass." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH の設定がこの接続先のホスト鍵を保存しない(UserKnownHostsFile /dev/null)ため、herdr の厳格なホスト鍵の確認を通過できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH 설정이 이 대상의 호스트 키를 보관하지 않으므로(UserKnownHostsFile /dev/null) herdr의 엄격한 호스트 키 확인을 통과할 수 없습니다." } }
      }
    },
    "Reconnect %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ に再接続" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 다시 연결" } }
      }
    },
    "Signed in, but the target didn't run the check that reads where herdr is." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログインしましたが、接続先で herdr の場所を調べるコマンドが実行されませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "로그인했지만 대상에서 herdr 위치를 확인하는 명령이 실행되지 않았습니다." } }
      }
    },
    "Signing in didn't finish within %lld seconds." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログインが %lld 秒以内に終わりませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "로그인이 %lld초 안에 끝나지 않았습니다." } }
      }
    },
    "Signing in to this target wants a browser (%@). Continue in a terminal to sign in." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この接続先へのログインにはブラウザが必要です(%@)。ターミナルで続けてログインしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 대상에 로그인하려면 브라우저가 필요합니다(%@). 터미널에서 계속해 로그인하십시오." } }
      }
    },
    "Stopped. The machine wasn't saved." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止しました。マシンは保存されていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "중지했습니다. 머신은 저장되지 않았습니다." } }
      }
    },
    "Stopping…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止中…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "중지하는 중…" } }
      }
    },
    "That SSH target is too long." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "SSH の接続先が長すぎます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "SSH 대상이 너무 깁니다." } }
      }
    },
    "That name is too long." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "名前が長すぎます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이름이 너무 깁니다." } }
      }
    },
    "The host didn't report how the step went." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストがステップの結果を返しませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트가 단계 결과를 알려 주지 않았습니다." } }
      }
    },
    "The host key can't be added to the known_hosts file OpenSSH's configuration names (%@). Continue in a terminal, where OpenSSH can add it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH の設定が指定する known_hosts ファイル(%@)にホスト鍵を追加できません。OpenSSH が追加できるターミナルで続けてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "OpenSSH 설정이 지정한 known_hosts 파일(%@)에 호스트 키를 추가할 수 없습니다. OpenSSH가 직접 추가할 수 있는 터미널에서 계속하십시오." } }
      }
    },
    "The host key couldn't be added to %@." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ にホスト鍵を追加できませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@에 호스트 키를 추가하지 못했습니다." } }
      }
    },
    "The host key isn't known yet. Fetching it…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "まだ認識していないホスト鍵です。取得中…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 모르는 호스트 키입니다. 가져오는 중…" } }
      }
    },
    "The host key of the machine this target is reached through isn't known yet. Continue in a terminal, where OpenSSH can ask about it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この接続先へ経由するマシンのホスト鍵がまだ分かりません。OpenSSH が確認できるターミナルで続けてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 대상에 연결할 때 거치는 머신의 호스트 키를 아직 모릅니다. OpenSSH가 직접 물어볼 수 있는 터미널에서 계속하십시오." } }
      }
    },
    "The host stopped answering, and the machine wasn't saved." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストが応答しなくなり、マシンは保存されませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트가 응답하지 않게 되어 머신이 저장되지 않았습니다." } }
      }
    },
    "The target's host key has been revoked." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続先のホスト鍵は失効しています。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대상의 호스트 키가 폐기되었습니다." } }
      }
    },
    "The target's host key isn't the one known for it. That happens when a machine is set up again — and when someone is in between." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続先のホスト鍵が既知の鍵と異なります。マシンを再セットアップしたときにも起きますが、誰かが間に入っているときにも起きます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대상의 호스트 키가 알고 있던 키와 다릅니다. 머신을 다시 설치했을 때도 그렇지만, 누군가 중간에 끼어들었을 때도 그렇습니다." } }
      }
    },
    "This target is saved already, as “%@”." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この接続先はすでに「%@」として保存されています。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 대상은 이미 ‘%@’(으)로 저장되어 있습니다." } }
      }
    },
    "Type a name." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "名前を入力してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이름을 입력하십시오." } }
      }
    },
    "Type an SSH target: a Host alias, user@host or ssh://user@host:port." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "SSH の接続先を入力してください: Host エイリアス、user@host または ssh://user@host:port。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "SSH 대상을 입력하십시오: Host 별칭, user@host 또는 ssh://user@host:port." } }
      }
    },
    "Waiting for you to trust the host key." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホスト鍵を信頼するかの確認待ちです。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 키를 신뢰할지 기다리는 중입니다." } }
      }
    },
    "herdr %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr %@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr %@" } }
      }
    },
    "herdr asks about this in a terminal. Continue there to approve it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr はこれをターミナルで確認します。ターミナルで続けて承認してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr는 이 내용을 터미널에서 묻습니다. 터미널에서 계속해 승인하십시오." } }
      }
    },
    "herdr at %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ の herdr" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@의 herdr" } }
      }
    },
    "herdr didn't finish removing the machine within %lld seconds." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr が %lld 秒以内にマシンの削除を終えませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr가 %lld초 안에 머신 제거를 끝내지 못했습니다." } }
      }
    },
    "herdr didn't finish within %lld seconds, and was stopped. The machine wasn't saved." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr が %lld 秒以内に終わらなかったため停止しました。マシンは保存されていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr가 %lld초 안에 끝나지 않아 중지했습니다. 머신은 저장되지 않았습니다." } }
      }
    },
    "herdr didn't reach the machine within %lld seconds." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr が %lld 秒以内にマシンへ接続できませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr가 %lld초 안에 머신에 연결하지 못했습니다." } }
      }
    },
    "herdr isn't installed there yet" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr はまだインストールされていません" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 herdr가 설치되어 있지 않음" } }
      }
    },
    "herdr on %@ reaches “%@” again." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ の herdr が再び「%2$@」に接続できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%1$@의 herdr가 다시 ‘%2$@’에 연결됩니다." } }
      }
    },
    "herdr signs in without asking for a password, so it needs a key: load yours into ssh-agent with `ssh-add`, or set this account up for key login. Then try again." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr はパスワードを尋ねずにログインするため、鍵が必要です。`ssh-add` で鍵を ssh-agent に読み込むか、このアカウントで鍵によるログインを設定してから再試行してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr는 암호를 묻지 않고 로그인하므로 키가 필요합니다. `ssh-add`로 키를 ssh-agent에 올리거나, 이 계정에 키 로그인을 설정한 뒤 다시 시도하십시오." } }
      }
    },
    "ssh exited with status %lld." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ssh はステータス %lld で終了しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "ssh가 상태 %lld로 종료했습니다." } }
      }
    },
    "via %@" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ 経由" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 경유" } }
      }
    },
    "via a ProxyCommand" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ProxyCommand 経由" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "ProxyCommand 경유" } }
      }
    },
    "“%@” is saved in herdr on %@." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%1$@」を %2$@ の herdr に保存しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘%1$@’을(를) %2$@의 herdr에 저장했습니다." } }
      }
    },
    ".local Name" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : ".local 名" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : ".local 이름" } }
      }
    },
    "Private IPv4" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プライベート IPv4" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "사설 IPv4" } }
      }
    },
    "“%@” isn't a .local name." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」は .local 名ではありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘%@’은(는) .local 이름이 아닙니다." } }
      }
    },
    "“%@” isn't a private IPv4 address." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」はプライベート IPv4 アドレスではありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘%@’은(는) 사설 IPv4 주소가 아닙니다." } }
      }
    },
    "“%@” isn't a Tailscale IPv4 address." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」は Tailscale IPv4 アドレスではありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘%@’은(는) Tailscale IPv4 주소가 아닙니다." } }
      }
    },
    "“%@” isn't a Tailscale MagicDNS name." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」は Tailscale MagicDNS 名ではありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘%@’은(는) Tailscale MagicDNS 이름이 아닙니다." } }
      }
    },
    "Looking up %@ took too long." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ の名前解決に時間がかかりすぎました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 이름을 조회하는 데 너무 오래 걸렸습니다." } }
      }
    },
    "%@ didn't resolve to a Tailscale address, so Shepherd didn't connect. Check that Tailscale is connected on this device and that Use Tailscale DNS is turned on." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ が Tailscale のアドレスに解決されなかったため、接続しませんでした。このデバイスで Tailscale が接続されていて、「Tailscale DNS を使用」がオンになっているか確認してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 이름이 Tailscale 주소로 조회되지 않아 연결하지 않았습니다. 이 기기에서 Tailscale이 연결되어 있고 ‘Tailscale DNS 사용’이 켜져 있는지 확인하세요." } }
      }
    },
    "%@ didn't resolve to an address on the local network, so Shepherd didn't connect." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ がローカルネットワーク上のアドレスに解決されなかったため、接続しませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 이름이 같은 네트워크 안의 주소로 조회되지 않아 연결하지 않았습니다." } }
      }
    },
    "A different device answered at %@. If the Mac's address has changed, scan its QR code again." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このアドレス(%@)で別のデバイスが応答しました。Mac のアドレスが変わった場合は、Mac の QR コードをもう一度スキャンしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 주소(%@)에서 다른 기기가 응답했습니다. Mac의 주소가 바뀌었다면 Mac의 QR 코드를 다시 스캔하세요." } }
      }
    },
    "This Mac removed this device's access. To connect again, remove the Mac from Machines, then scan a new QR code on the Mac." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac でこのデバイスのアクセスが解除されました。再び接続するには、マシンからこの Mac を削除してから、Mac に表示される新しい QR コードをスキャンしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에서 이 기기의 접근이 해제됐습니다. 다시 연결하려면 머신에서 이 Mac을 지운 뒤 Mac에 표시되는 새 QR 코드를 스캔하세요." } }
      }
    },
    "The device sent a key that isn't a P-256 SSH public key." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "デバイスから送られた鍵は P-256 の SSH 公開鍵ではありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기기가 보낸 키가 P-256 SSH 공개 키가 아닙니다." } }
      }
    },
    "This device has no Secure Enclave to keep its key in." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このデバイスには鍵を保管する Secure Enclave がありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 기기에는 키를 보관할 Secure Enclave가 없습니다." } }
      }
    },
    "This device's key for the Mac can't be used. Remove the Mac and pair it again." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac に接続するためのこのデバイスの鍵を使用できません。Mac を削除して、もう一度ペアリングしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에 접속할 이 기기의 키를 쓸 수 없습니다. Mac을 지우고 다시 페어링하세요." } }
      }
    },
    "This isn't a Shepherd pairing code." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Shepherd のペアリングコードではありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Shepherd 페어링 코드가 아닙니다." } }
      }
    },
    "This pairing code needs a newer version of Shepherd. Update the app, then scan the code again." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このペアリングコードを読み取るには新しいバージョンの Shepherd が必要です。App をアップデートしてから、もう一度スキャンしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 페어링 코드를 읽으려면 새 버전의 Shepherd가 필요합니다. 앱을 업데이트한 뒤 다시 스캔하세요." } }
      }
    },
    "This pairing code is damaged or incomplete." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードが破損しているか、不完全です。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "페어링 코드가 손상되었거나 일부가 빠졌습니다." } }
      }
    },
    "This pairing code has expired. Show a new one on the Mac." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングコードの有効期限が切れました。Mac で新しいコードを表示してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "페어링 코드가 만료되었습니다. Mac에서 새 코드를 표시하세요." } }
      }
    },
    "The pairing message couldn't be read." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングメッセージを読み取れませんでした。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "페어링 메시지를 읽을 수 없습니다." } }
      }
    },
    "This QR code was already used. Show a new one on the Mac and scan it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この QR コードはすでに使用されています。Mac で新しいコードを表示してスキャンしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미 사용된 QR 코드입니다. Mac에서 새 코드를 표시해 스캔하세요." } }
      }
    },
    "The Mac isn't showing this QR code anymore. Show a new one on the Mac and scan it." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Mac にはこの QR コードがもう表示されていません。Mac で新しいコードを表示してスキャンしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Mac에 더 이상 이 QR 코드가 표시되어 있지 않습니다. Mac에서 새 코드를 표시해 스캔하세요." } }
      }
    }
  },
  "version" : "1.1"
}
