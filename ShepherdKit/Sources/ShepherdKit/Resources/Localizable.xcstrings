      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No saved SSH credential was found. Edit the machine to set up authentication." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存済みの SSH 認証情報がありません。マシンを編集して認証を設定してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 SSH 인증 정보가 없습니다. 머신을 수정하여 인증을 설정해 주세요." } }
