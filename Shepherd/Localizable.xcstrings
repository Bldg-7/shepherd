            "value" : "알 수 없음"
          }
        }
      }
    },
    "Unlock failed or the context is locked. No vendor-global lock or signout was performed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock failed or the context is locked. No vendor-global lock or signout was performed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック解除に失敗したか設定がロック中です。ベンダー全体のロックやサインアウトは行っていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 해제에 실패했거나 설정이 잠겨 있습니다. 공급업체 전체 잠금이나 로그아웃을 수행하지 않았습니다."
          }
        }
      }
    },
    "Unsupported CLI version. Targets are op 2.32.0 and bw 2025.11.0; real vendor compatibility has not been verified." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
