        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In-app Browser 스킬"
          }
        }
      }
    },
    "hrdrhrdrhrdr generated a key on this device. Run this on %@ to authorize it:" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hrdrhrdrhrdr がこのデバイスで鍵を生成しました。%@ で次のコマンドを実行して鍵を登録してください:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hrdrhrdrhrdr가 이 기기에서 키를 생성했습니다. %@에서 다음 명령어를 실행해 키를 등록하십시오:"
          }
        }
      }
    },
    "hrdrhrdrhrdr generated a key on this device. Run this on the machine to authorize it:" : {
