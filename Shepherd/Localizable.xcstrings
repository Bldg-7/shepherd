          }
        }
      }
    },
    "Add herdr Machine…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr machine を追加…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr machine 추가…" } }
      }
    },
    "Connect to This Mac to add a herdr machine." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "herdr machine を追加するには、このMac に接続してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "herdr machine을 추가하려면 이 Mac에 연결하세요." } }
      }
    },
    "%lld s" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld 秒" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%lld초" } }
      }
    },
    "Continue in Terminal" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ターミナルで続ける" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "터미널에서 계속" } }
      }
    },
    "Name the machine and press Return. Left empty, it is called “%@”." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "名前を入力して Return キーを押してください。空欄のままにすると「%@」になります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이름을 입력하고 Return 키를 누르십시오. 비워 두면 이름은 ‘%@’이(가) 됩니다." } }
      }
    },
    "No Host aliases in ~/.ssh/config. Type a target." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "~/.ssh/config に Host エイリアスがありません。接続先を入力してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "~/.ssh/config에 Host 별칭이 없습니다. 대상을 입력하십시오." } }
      }
    },
    "Open Terminal" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ターミナルを開く" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "터미널 열기" } }
      }
    },
    "Pick a Host alias from ~/.ssh/config on %@, or type an SSH target — user@host, or ssh://user@host:port — and press Return." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ の ~/.ssh/config にある Host エイリアスを選ぶか、SSH の接続先(user@host または ssh://user@host:port)を入力して Return キーを押してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@의 ~/.ssh/config에 있는 Host 별칭을 고르거나, SSH 대상(user@host 또는 ssh://user@host:port)을 입력하고 Return 키를 누르십시오." } }
      }
    },
    "Reach the machine's herdr" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンの herdr に接続" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신의 herdr에 연결" } }
      }
    },
