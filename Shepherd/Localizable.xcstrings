      }
    },
    "Only valid HTTP and HTTPS links without embedded credentials can be opened." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "認証情報を含まない、有効な HTTP または HTTPS リンクのみ開けます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "인증 정보가 포함되지 않은 유효한 HTTP 또는 HTTPS 링크만 열 수 있습니다." } }
      }
    },
    "File Preview": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일 미리보기"}},"ja":{"stringUnit":{"state":"translated","value":"ファイルプレビュー"}}}},
    "Show Preview": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"미리보기 표시"}},"ja":{"stringUnit":{"state":"translated","value":"プレビューを表示"}}}},
