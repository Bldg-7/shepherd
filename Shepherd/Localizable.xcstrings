        }
      }
    },
    "An agent is using this pane's In-app Browser, so the file opened in the default browser." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agent がこの pane の In-app Browser を使っているため、デフォルトブラウザで開きました。"
