    "Cannot Preview File": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일을 미리 볼 수 없음"}},"ja":{"stringUnit":{"state":"translated","value":"ファイルをプレビューできません"}}}},
    "Preview truncated to 120,000 characters.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"미리보기는 120,000자까지만 표시합니다."}},"ja":{"stringUnit":{"state":"translated","value":"プレビューは120,000文字まで表示します。"}}}},
    "This file path is not supported.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"지원하지 않는 파일 경로입니다."}},"ja":{"stringUnit":{"state":"translated","value":"このファイルパスはサポートされていません。"}}}},
    "Only file links can be opened in this preview.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일 링크만 미리보기로 열 수 있습니다."}},"ja":{"stringUnit":{"state":"translated","value":"このプレビューではファイルリンクのみ開けます。"}}}},
    "The file link belongs to a different machine.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"다른 머신의 파일 링크입니다."}},"ja":{"stringUnit":{"state":"translated","value":"別のマシンのファイルリンクです。"}}}},
    "The pane's working directory is unknown. Use an absolute file path.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"pane의 작업 디렉터리를 알 수 없습니다. 절대 경로를 사용하세요."}},"ja":{"stringUnit":{"state":"translated","value":"paneの作業ディレクトリが不明です。絶対パスを使ってください。"}}}},
    "File preview is not available for nested Herdr machines.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"중첩된 Herdr 머신의 파일 미리보기는 지원하지 않습니다."}},"ja":{"stringUnit":{"state":"translated","value":"入れ子のHerdrマシンのファイルプレビューは未対応です。"}}}},
    "This file is too large to preview (4 MB maximum).": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일이 너무 큽니다. 최대 4 MB까지 미리 볼 수 있습니다."}},"ja":{"stringUnit":{"state":"translated","value":"ファイルが大きすぎます。プレビューは最大4 MBです。"}}}},
    "Only regular files can be previewed.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"일반 파일만 미리 볼 수 있습니다."}},"ja":{"stringUnit":{"state":"translated","value":"通常のファイルのみプレビューできます。"}}}},
    "This file type or text encoding cannot be previewed.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"지원하지 않는 파일 형식이나 텍스트 인코딩입니다."}},"ja":{"stringUnit":{"state":"translated","value":"このファイル形式または文字コードはプレビューできません。"}}}},
    "Connect to this machine's terminal first to verify its host key.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"먼저 해당 머신의 터미널에 연결하여 호스트 키를 확인하세요."}},"ja":{"stringUnit":{"state":"translated","value":"先にこのマシンのターミナルへ接続してホスト鍵を確認してください。"}}}},
    "Reading the file timed out.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일 읽기 시간이 초과되었습니다."}},"ja":{"stringUnit":{"state":"translated","value":"ファイルの読込がタイムアウトしました。"}}}},
    "Edit Machine": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Edit Machine"}}, "ja": {"stringUnit": {"state": "translated", "value": "マシンを編集"}}, "ko": {"stringUnit": {"state": "translated", "value": "머신 수정"}}}},
    "Change Authentication": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Change Authentication"}}, "ja": {"stringUnit": {"state": "translated", "value": "認証情報を変更"}}, "ko": {"stringUnit": {"state": "translated", "value": "인증 정보 변경"}}}},
    "Saved password will be kept": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved password will be kept"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みのパスワードを維持します"}}, "ko": {"stringUnit": {"state": "translated", "value": "저장된 암호를 유지합니다"}}}},
    "Saved SSH key will be kept": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved SSH key will be kept"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みの SSH 鍵を維持します"}}, "ko": {"stringUnit": {"state": "translated", "value": "저장된 SSH 키를 유지합니다"}}}},
    "Your saved credential is not displayed or changed unless you turn on Change Authentication.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Your saved credential is not displayed or changed unless you turn on Change Authentication."}}, "ja": {"stringUnit": {"state": "translated", "value": "「認証情報を変更」をオンにしない限り、保存済みの認証情報を表示・変更しません。"}}, "ko": {"stringUnit": {"state": "translated", "value": "인증 정보 변경을 켜지 않으면 저장된 인증 정보를 표시하거나 변경하지 않습니다."}}}},
    "Changing connection settings reconnects the machine. Select a pane again afterwards. Renaming alone keeps the connection.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Changing connection settings reconnects the machine. Select a pane again afterwards. Renaming alone keeps the connection."}}, "ja": {"stringUnit": {"state": "translated", "value": "接続設定を変えると再接続します。その後、pane を選び直してください。名前だけの変更では接続を維持します。"}}, "ko": {"stringUnit": {"state": "translated", "value": "연결 설정을 바꾸면 재연결합니다. 이후 pane을 다시 선택하세요. 이름만 바꾸면 연결을 유지합니다."}}}},
    "Changing the hostname or port clears the saved host key. The new server will be trusted on first connection.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Changing the hostname or port clears the saved host key. The new server will be trusted on first connection."}}, "ja": {"stringUnit": {"state": "translated", "value": "ホスト名またはポートを変えると保存済みのホスト鍵を解除します。新しいサーバーは初回接続時に信頼されます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "호스트 이름이나 포트를 바꾸면 저장된 호스트 키를 해제하고, 첫 연결에서 새 서버를 신뢰합니다."}}}},
    "Changing the session removes its old pane browsers and their isolated profiles.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Changing the session removes its old pane browsers and their isolated profiles."}}, "ja": {"stringUnit": {"state": "translated", "value": "セッションを変えると、以前の pane ブラウザとその分離プロファイルが削除されます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "세션을 바꾸면 이전 pane 브라우저와 해당 격리 프로필이 삭제됩니다."}}}},
    "Enter the SSH hostname or IP address, without a username, scheme or port.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enter the SSH hostname or IP address, without a username, scheme or port."}}, "ja": {"stringUnit": {"state": "translated", "value": "ユーザー名・スキーム・ポートを除いた SSH ホスト名または IP アドレスを入力してください。"}}, "ko": {"stringUnit": {"state": "translated", "value": "사용자 이름·주소 스킴·포트를 빼고 SSH 호스트 이름이나 IP 주소만 입력하세요."}}}},
    "The machine couldn't be saved. %@": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The machine couldn't be saved. %@"}}, "ja": {"stringUnit": {"state": "translated", "value": "マシンを保存できませんでした。%@"}}, "ko": {"stringUnit": {"state": "translated", "value": "머신을 저장하지 못했습니다. %@"}}}},
    "Pi": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pi"}}, "ja": {"stringUnit": {"state": "translated", "value": "Pi"}}, "ko": {"stringUnit": {"state": "translated", "value": "Pi"}}}},
    "Pi package or version has not been qualified": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pi package or version has not been qualified"}}, "ja": {"stringUnit": {"state": "translated", "value": "Pi のパッケージまたはバージョンは未検証です"}}, "ko": {"stringUnit": {"state": "translated", "value": "Pi 패키지 또는 버전이 검증되지 않았습니다"}}}},
    "Pi requires Node 22.19 or newer": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pi requires Node 22.19 or newer"}}, "ja": {"stringUnit": {"state": "translated", "value": "Pi には Node 22.19 以降が必要です"}}, "ko": {"stringUnit": {"state": "translated", "value": "Pi는 Node 22.19 이상이 필요합니다"}}}},
    "Pi detected; managed browser launch is not enabled yet": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pi detected; managed browser launch is not enabled yet"}}, "ja": {"stringUnit": {"state": "translated", "value": "Pi を検出しました。管理対象ブラウザでの起動はまだ有効ではありません"}}, "ko": {"stringUnit": {"state": "translated", "value": "Pi를 발견했습니다. 관리형 브라우저 실행은 아직 활성화되지 않았습니다"}}}},
    "%@ wants to:" : {
