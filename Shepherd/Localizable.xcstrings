      }
    },
    "The selected CLI is unavailable. Install and configure it yourself; nothing is installed automatically." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected CLI is unavailable. Install and configure it yourself; nothing is installed automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したCLIは利用できません。利用者がインストール・設定してください。自動インストールは行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 CLI를 사용할 수 없습니다. 직접 설치하고 설정하세요. 자동으로 설치하지 않습니다."
          }
        }
      }
    },
    "The Service Account identity or readable vaults changed. Existing approvals were revoked. Reconnect explicitly." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Service Account identity or readable vaults changed. Existing approvals were revoked. Reconnect explicitly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Account または読み取り可能な保管庫が変わりました。既存の承認を失効しました。再接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Account 또는 읽기 가능한 Vault가 변경되었습니다. 기존 승인을 폐기했습니다. 직접 다시 연결하세요."
          }
        }
      }
    },
    "The Service Account's readable vaults could not be verified. No connection was accepted." : {
      "localizations" : {
