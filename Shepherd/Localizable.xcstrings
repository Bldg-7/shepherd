    },
    "This session has no verified saved conversation in its current CLI configuration and folder. Send a message and wait for it to finish, then try Resume again. The original agent was not stopped." : {
      "comment" : "Error message displayed when a saved conversation cannot be verified.",
      "isCommentAutoGenerated" : true
    },
    "Trying again automatically." : {
