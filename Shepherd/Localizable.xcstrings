            "value" : "기본 브라우저에서 열기"
          }
        }
      }
    },
    "In-app Browser isn't available on this Mac, so the link opened in the default browser." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac では In-app Browser を使えないため、デフォルトブラウザで開きました。"
