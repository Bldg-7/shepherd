{
  "sourceLanguage" : "en",
  "strings" : {
    "Clear timed out and may still be finishing. Some data may already have been removed." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "消去がタイムアウトし、まだ処理中の可能性があります。一部のデータはすでに削除されている場合があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지우기 시간이 초과되어 작업이 아직 진행 중일 수 있습니다. 일부 데이터는 이미 삭제되었을 수 있습니다." } }
      }
    },
    "Clear Saved Conversations?" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存された会話を消去しますか？" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 대화를 지울까요?" } }
      }
    },
    "Clear Saved Conversations" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存された会話を消去" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 대화 지우기" } }
      }
    },
    "Saved conversation files on this Mac will be removed where possible. Backups, snapshots, already delivered content and older volatile conversations may remain. New captures may include history sent again by the agent." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac の保存済み会話ファイルを可能な範囲で削除します。バックアップ、スナップショット、送信済みの内容や旧バージョンのメモリ内会話は残る場合があります。新しい収集にはエージェントが再送した履歴が含まれる場合があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에 저장된 대화 파일을 가능한 범위에서 삭제합니다. 백업, 스냅샷, 이미 전달된 내용과 이전 버전의 메모리 대화는 남을 수 있습니다. 새로 수집한 내용에는 에이전트가 다시 보낸 기록이 포함될 수 있습니다." } }
      }
    },
    "Saved conversations were cleared. New captures may include history sent again by the agent." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存された会話を消去しました。新しい収集にはエージェントが再送した履歴が含まれる場合があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 대화를 지웠습니다. 새로 수집한 내용에는 에이전트가 다시 보낸 기록이 포함될 수 있습니다." } }
      }
    },
    "Saved conversations could not be fully cleared. Some data may already have been removed." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存された会話を完全に消去できませんでした。一部のデータはすでに削除されている場合があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 대화를 모두 지우지 못했습니다. 일부 데이터는 이미 삭제되었을 수 있습니다." } }
      }
    },
    "Backups and snapshots may retain copies; physical or cryptographic erasure is not guaranteed." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "バックアップやスナップショットにコピーが残る場合があり、物理的または暗号学的な消去は保証されません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "백업과 스냅샷에 복사본이 남을 수 있으며 물리적 또는 암호학적 삭제는 보장되지 않습니다." } }
      }
    },
    "Some saved history is unavailable or could not be saved. Live capture may continue." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存された履歴の一部を利用または保存できません。ライブ収集は続行される場合があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 기록 일부를 사용할 수 없거나 저장하지 못했습니다. 실시간 수집은 계속될 수 있습니다." } }
      }
    },
    "The last storage index check succeeded. Individual records may still be unreadable, and recent changes may still be saving." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "前回の保存インデックス確認に成功しました。個々の記録を読み取れない場合や、最近の変更がまだ保存中の場合があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "마지막 저장 인덱스 확인에 성공했습니다. 개별 기록을 읽지 못할 수 있으며 최근 변경 사항은 아직 저장 중일 수 있습니다." } }
      }
    },
    "Saved history storage has not been verified." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "履歴の保存先はまだ確認されていません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기록 저장소가 아직 확인되지 않았습니다." } }
      }
    },
    "Saved history status is unavailable." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存履歴の状態を取得できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 기록의 상태를 확인할 수 없습니다." } }
      }
    },
    "Saved history is subject to a 30-day, 256-conversation and 256 MiB policy when storage is maintained. Turning this setting off keeps saved history." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存履歴はストレージのメンテナンス時に 30 日、256 件、256 MiB のポリシーに従います。設定をオフにしても保存履歴は残ります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 기록은 저장소를 관리할 때 30일, 대화 256개, 256 MiB 정책을 따릅니다. 이 설정을 꺼도 저장된 기록은 유지됩니다." } }
      }
    },
    "Clear Saved Conversations…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存された会話を消去…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 대화 지우기…" } }
      }
    },
    "Go to Agent or Pane…" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "agent または pane へ移動…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "agent 또는 pane으로 이동…" } }
      }
    },
    "Go to Agent or Pane… (⌘P)" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "agent または pane へ移動… (⌘P)" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "agent 또는 pane으로 이동… (⌘P)" } }
      }
    },
    "Expand Preview" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プレビューを拡大" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리보기 확대" } }
      }
    },
    "Restore Preview Size" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プレビューのサイズを戻す" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리보기 크기 복원" } }
      }
    },
    "Table of Contents" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "目次" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "목차" } }
      }
    },
    "Show Table of Contents" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "目次を表示" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "목차 보기" } }
      }
    },
    "Hide Table of Contents" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "目次を隠す" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "목차 숨기기" } }
      }
    },
    "No Headings" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "見出しなし" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "목차에 넣을 제목 없음" } }
      }
    },
    "Find" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "検索" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "찾기" } }
      }
    },
    "No Results" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "結果なし" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "결과 없음" } }
      }
    },
    "Find Previous" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "前を検索" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이전 찾기" } }
      }
    },
    "Find Next" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次を検索" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 찾기" } }
      }
    },
    "Find Previous (⇧⌘G)" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "前を検索 (⇧⌘G)" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이전 찾기 (⇧⌘G)" } }
      }
    },
    "Find Next (⌘G)" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次を検索 (⌘G)" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 찾기 (⌘G)" } }
      }
    },
    "Close Find Bar" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "検索バーを閉じる" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "찾기 막대 닫기" } }
      }
    },
    "Reload (⌘R)" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再読み込み (⌘R)" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새로고침 (⌘R)" } }
      }
    },
    "Frontmatter" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "フロントマター" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프런트매터" } }
      }
    },
    "Checked" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "チェック済み" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택됨" } }
      }
    },
    "Unchecked" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "未チェック" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택 안 됨" } }
      }
    },
    "Hide Sidebar" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サイドバーを非表示" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "사이드바 가리기" } }
      }
    },
    "Show Sidebar" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サイドバーを表示" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "사이드바 보기" } }
      }
    },
    "Could Not Open Link" : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "リンクを開けませんでした" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "링크를 열 수 없습니다" } }
      }
    },
    "Enable Experimental Browser in Settings to open web links." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ウェブリンクを開くには、設定で実験的ブラウザを有効にしてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "웹 링크를 열려면 설정에서 실험적 브라우저를 켜 주세요." } }
      }
    },
    "Only valid HTTP and HTTPS links without embedded credentials can be opened." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "認証情報を含まない、有効な HTTP または HTTPS リンクのみ開けます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "인증 정보가 포함되지 않은 유효한 HTTP 또는 HTTPS 링크만 열 수 있습니다." } }
      }
    },
    "File Preview": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일 미리보기"}},"ja":{"stringUnit":{"state":"translated","value":"ファイルプレビュー"}}}},
    "Show Preview": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"미리보기 표시"}},"ja":{"stringUnit":{"state":"translated","value":"プレビューを表示"}}}},
    "Hide Preview": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"미리보기 숨기기"}},"ja":{"stringUnit":{"state":"translated","value":"プレビューを隠す"}}}},
    "Close Preview": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"미리보기 닫기"}},"ja":{"stringUnit":{"state":"translated","value":"プレビューを閉じる"}}}},
    "Reading File…": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일 읽는 중…"}},"ja":{"stringUnit":{"state":"translated","value":"ファイルを読込中…"}}}},
    "Source": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"원본"}},"ja":{"stringUnit":{"state":"translated","value":"ソース"}}}},
    "Line %lld": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"%lld행"}},"ja":{"stringUnit":{"state":"translated","value":"%lld行"}}}},
    "Cannot Preview File": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일을 미리 볼 수 없음"}},"ja":{"stringUnit":{"state":"translated","value":"ファイルをプレビューできません"}}}},
    "Preview truncated to 120,000 characters.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"미리보기는 120,000자까지만 표시합니다."}},"ja":{"stringUnit":{"state":"translated","value":"プレビューは120,000文字まで表示します。"}}}},
    "This file path is not supported.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"지원하지 않는 파일 경로입니다."}},"ja":{"stringUnit":{"state":"translated","value":"このファイルパスはサポートされていません。"}}}},
    "Only file links can be opened in this preview.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일 링크만 미리보기로 열 수 있습니다."}},"ja":{"stringUnit":{"state":"translated","value":"このプレビューではファイルリンクのみ開けます。"}}}},
    "The file link belongs to a different machine.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"다른 머신의 파일 링크입니다."}},"ja":{"stringUnit":{"state":"translated","value":"別のマシンのファイルリンクです。"}}}},
    "The pane's working directory is unknown. Use an absolute file path.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"pane의 작업 디렉터리를 알 수 없습니다. 절대 경로를 사용하세요."}},"ja":{"stringUnit":{"state":"translated","value":"paneの作業ディレクトリが不明です。絶対パスを使ってください。"}}}},
    "File preview is not available for nested Herdr machines.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"중첩된 Herdr 머신의 파일 미리보기는 지원하지 않습니다."}},"ja":{"stringUnit":{"state":"translated","value":"入れ子のHerdrマシンのファイルプレビューは未対応です。"}}}},
    "This file is too large to preview (4 MB maximum).": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일이 너무 큽니다. 최대 4 MB까지 미리 볼 수 있습니다."}},"ja":{"stringUnit":{"state":"translated","value":"ファイルが大きすぎます。プレビューは最大4 MBです。"}}}},
    "Only regular files can be previewed.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"일반 파일만 미리 볼 수 있습니다."}},"ja":{"stringUnit":{"state":"translated","value":"通常のファイルのみプレビューできます。"}}}},
    "This file type or text encoding cannot be previewed.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"지원하지 않는 파일 형식이나 텍스트 인코딩입니다."}},"ja":{"stringUnit":{"state":"translated","value":"このファイル形式または文字コードはプレビューできません。"}}}},
    "Connect to this machine's terminal first to verify its host key.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"먼저 해당 머신의 터미널에 연결하여 호스트 키를 확인하세요."}},"ja":{"stringUnit":{"state":"translated","value":"先にこのマシンのターミナルへ接続してホスト鍵を確認してください。"}}}},
    "Reading the file timed out.": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일 읽기 시간이 초과되었습니다."}},"ja":{"stringUnit":{"state":"translated","value":"ファイルの読込がタイムアウトしました。"}}}},
    "Edit Machine": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Edit Machine"}}, "ja": {"stringUnit": {"state": "translated", "value": "マシンを編集"}}, "ko": {"stringUnit": {"state": "translated", "value": "머신 수정"}}}},
    "Change Authentication": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Change Authentication"}}, "ja": {"stringUnit": {"state": "translated", "value": "認証情報を変更"}}, "ko": {"stringUnit": {"state": "translated", "value": "인증 정보 변경"}}}},
    "Saved password will be kept": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved password will be kept"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みのパスワードを維持します"}}, "ko": {"stringUnit": {"state": "translated", "value": "저장된 암호를 유지합니다"}}}},
    "Saved SSH key will be kept": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Saved SSH key will be kept"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存済みの SSH 鍵を維持します"}}, "ko": {"stringUnit": {"state": "translated", "value": "저장된 SSH 키를 유지합니다"}}}},
    "Your saved credential is not displayed or changed unless you turn on Change Authentication.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Your saved credential is not displayed or changed unless you turn on Change Authentication."}}, "ja": {"stringUnit": {"state": "translated", "value": "「認証情報を変更」をオンにしない限り、保存済みの認証情報を表示・変更しません。"}}, "ko": {"stringUnit": {"state": "translated", "value": "인증 정보 변경을 켜지 않으면 저장된 인증 정보를 표시하거나 변경하지 않습니다."}}}},
    "Changing connection settings reconnects the machine. Select a pane again afterwards. Renaming alone keeps the connection.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Changing connection settings reconnects the machine. Select a pane again afterwards. Renaming alone keeps the connection."}}, "ja": {"stringUnit": {"state": "translated", "value": "接続設定を変えると再接続します。その後、pane を選び直してください。名前だけの変更では接続を維持します。"}}, "ko": {"stringUnit": {"state": "translated", "value": "연결 설정을 바꾸면 재연결합니다. 이후 pane을 다시 선택하세요. 이름만 바꾸면 연결을 유지합니다."}}}},
    "Changing the hostname or port clears the saved host key. The new server will be trusted on first connection.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Changing the hostname or port clears the saved host key. The new server will be trusted on first connection."}}, "ja": {"stringUnit": {"state": "translated", "value": "ホスト名またはポートを変えると保存済みのホスト鍵を解除します。新しいサーバーは初回接続時に信頼されます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "호스트 이름이나 포트를 바꾸면 저장된 호스트 키를 해제하고, 첫 연결에서 새 서버를 신뢰합니다."}}}},
    "Changing the session removes its old pane browsers and their isolated profiles.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Changing the session removes its old pane browsers and their isolated profiles."}}, "ja": {"stringUnit": {"state": "translated", "value": "セッションを変えると、以前の pane ブラウザとその分離プロファイルが削除されます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "세션을 바꾸면 이전 pane 브라우저와 해당 격리 프로필이 삭제됩니다."}}}},
    "Enter the SSH hostname or IP address, without a username, scheme or port.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enter the SSH hostname or IP address, without a username, scheme or port."}}, "ja": {"stringUnit": {"state": "translated", "value": "ユーザー名・スキーム・ポートを除いた SSH ホスト名または IP アドレスを入力してください。"}}, "ko": {"stringUnit": {"state": "translated", "value": "사용자 이름·주소 스킴·포트를 빼고 SSH 호스트 이름이나 IP 주소만 입력하세요."}}}},
    "The machine couldn't be saved. %@": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The machine couldn't be saved. %@"}}, "ja": {"stringUnit": {"state": "translated", "value": "マシンを保存できませんでした。%@"}}, "ko": {"stringUnit": {"state": "translated", "value": "머신을 저장하지 못했습니다. %@"}}}},
    "Pi": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pi"}}, "ja": {"stringUnit": {"state": "translated", "value": "Pi"}}, "ko": {"stringUnit": {"state": "translated", "value": "Pi"}}}},
    "Pi package or version has not been qualified": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pi package or version has not been qualified"}}, "ja": {"stringUnit": {"state": "translated", "value": "Pi のパッケージまたはバージョンは未検証です"}}, "ko": {"stringUnit": {"state": "translated", "value": "Pi 패키지 또는 버전이 검증되지 않았습니다"}}}},
    "Pi requires Node 22.19 or newer": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pi requires Node 22.19 or newer"}}, "ja": {"stringUnit": {"state": "translated", "value": "Pi には Node 22.19 以降が必要です"}}, "ko": {"stringUnit": {"state": "translated", "value": "Pi는 Node 22.19 이상이 필요합니다"}}}},
    "Pi detected; managed browser launch is not enabled yet": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pi detected; managed browser launch is not enabled yet"}}, "ja": {"stringUnit": {"state": "translated", "value": "Pi を検出しました。管理対象ブラウザでの起動はまだ有効ではありません"}}, "ko": {"stringUnit": {"state": "translated", "value": "Pi를 발견했습니다. 관리형 브라우저 실행은 아직 활성화되지 않았습니다"}}}},
