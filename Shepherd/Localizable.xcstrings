        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のマシンのペインに添付できるのは PNG、JPEG、GIF、WebP 画像だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 머신의 pane에는 PNG, JPEG, GIF, WebP 이미지만 첨부할 수 있습니다."
          }
        }
      }
    },
