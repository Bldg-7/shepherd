    "Reading File…": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"파일 읽는 중…"}},"ja":{"stringUnit":{"state":"translated","value":"ファイルを読込中…"}}}},
    "Source": {"localizations":{"ko":{"stringUnit":{"state":"translated","value":"원본"}},"ja":{"stringUnit":{"state":"translated","value":"ソース"}}}},
