  },
  "Observed subagents: %lld · With final results: %lld": {
    "extractionState": "manual",
    "localizations": {
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "관측된 서브에이전트: %1$lld · 최종 결과 있음: %2$lld"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "確認したサブエージェント: %1$lld・最終結果あり: %2$lld"
        }
      }
    }
  },
  "Subagent tracking reached its memory limit.": {
    "extractionState": "manual",
    "localizations": {
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "서브에이전트 추적이 메모리 한도에 도달했습니다."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "サブエージェントの追跡がメモリ上限に達しました。"
