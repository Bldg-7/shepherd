    "Add this line to ~/.ssh/authorized_keys on the machine. The private key never leaves this device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンの ~/.ssh/authorized_keys にこの行を追加してください。秘密鍵がこのデバイスの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "머신의 ~/.ssh/authorized_keys에 이 줄을 추가하세요. 개인 키는 이 기기 밖으로 나가지 않습니다."
          }
        }
      }
    },
