    "%@ asks whether to let this device in. Check that it shows the same confirmation code, then approve it there." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ がこのデバイスを許可するか確認しています。同じ確認コードが表示されていることを確かめてから、Mac で承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이 기기를 허용할지 묻고 있습니다. 같은 확인 코드가 표시되는지 확인한 뒤 Mac에서 승인하세요."
          }
        }
      }
    },
    "%@ is already in Machines with this address." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はすでにこのアドレスで追加されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 항목이 이미 이 주소로 추가되어 있습니다."
          }
        }
      }
    },
    "%@ is already in Machines." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はすでにマシンにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 항목이 이미 머신에 있습니다."
          }
        }
      }
    },
    "%@ is already in Machines. This device connects to the new address with the key it already has and the Mac's saved host key, and switches to it only if that works. The Mac doesn't need to approve it again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はすでにマシンにあります。このデバイスは手元の鍵と保存済みの Mac のホストキーで新しいアドレスに接続し、接続できた場合にのみ切り替えます。Mac で再度承認する必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 항목이 이미 머신에 있습니다. 이 기기는 가지고 있는 키와 저장된 Mac의 호스트 키로 새 주소에 연결해 보고, 연결되는 경우에만 새 주소로 바꿉니다. Mac에서 다시 승인할 필요는 없습니다."
          }
        }
      }
    },
    "%@ was added, but connecting to it failed: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ を追加しましたが、接続できませんでした: %2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 항목을 추가했지만 연결하지 못했습니다: %2$@"
          }
        }
      }
    },
    "%@ was added, but it didn't let this device in. If the Mac showed a command to run in Terminal, run it there, then open %@ in Machines." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ を追加しましたが、Mac はこのデバイスのログインを受け入れませんでした。Mac にターミナルで実行するコマンドが表示された場合は、そこで実行してから、マシンで %2$@ を開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 항목을 추가했지만 Mac이 이 기기의 로그인을 받아들이지 않았습니다. Mac에 터미널에서 실행할 명령이 표시됐다면 그 명령을 실행한 뒤 머신에서 %2$@ 항목을 여세요."
          }
        }
      }
    },
    "%@ was added, but its herdr didn't answer: %@ Check that herdr is running on the Mac." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ を追加しましたが、herdr が応答しませんでした: %2$@ Mac で herdr が動作しているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 항목을 추가했지만 herdr가 응답하지 않았습니다: %2$@ Mac에서 herdr가 실행 중인지 확인하세요."
          }
        }
      }
    },
